# Environment Configuration Template
# Copy this file to .env and fill in your actual values
#
# Quick Setup:
#   1. Copy: cp .env.example .env
#   2. Edit: nano .env
#   3. Change DATABASE_URL username/password to match your PostgreSQL
#   4. Generate secure JWT_SECRET: openssl rand -base64 32
#   5. Update other values as needed

# ========================================
# Database Configuration
# ========================================
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:password@localhost/sleep_monitor

# ========================================
# Security Configuration
# ========================================
# JWT Secret Key - MUST CHANGE IN PRODUCTION!
# Generate secure key with: openssl rand -base64 32
# This key signs authentication tokens for Pi devices
JWT_SECRET=your-secret-key-change-this-in-production

# ========================================
# Redis Configuration
# ========================================
# Redis cache for real-time data streaming
# Default works for local development
REDIS_URL=redis://127.0.0.1:6379

# ========================================
# Server Configuration
# ========================================
# Host address (0.0.0.0 = all interfaces)
SERVER_HOST=0.0.0.0

# Port number
SERVER_PORT=3000

# ========================================
# Logging Configuration
# ========================================
# Log verbosity level
# Options: trace (most verbose), debug, info, warn, error (least verbose)
# Recommended: info for production, debug for development
RUST_LOG=info

# ========================================
# CORS Configuration
# ========================================
# Allowed origins for cross-origin requests (comma-separated)
# For production, restrict to your actual frontend domain
# Example: https://yourdomain.com,https://dashboard.yourdomain.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ========================================
# Production Security Checklist
# ========================================
# Before deploying to production:
# [ ] Change JWT_SECRET to a strong random value
# [ ] Update DATABASE_URL with production credentials
# [ ] Set CORS_ORIGINS to your actual frontend domain(s)
# [ ] Set RUST_LOG=info (not debug/trace)
# [ ] Use HTTPS/TLS for DATABASE_URL if remote
# [ ] Ensure Redis is password-protected if exposed
# [ ] Never commit .env file to version control!
