# Docker ignore file - exclude from Docker build context
# This speeds up builds and reduces image size

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
*.pdf
*.txt
!backend/migrations/*.sql

# Build artifacts
backend/target/
backend/Cargo.lock

# Environment files
backend/.env
backend/.env.*
!backend/.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test files
backend/test_*.sh
backend/generate_*.sh
backend/setup_*.sh

# Logs
*.log

# Temporary files
*.tmp
*.bak
*.backup
